```
<!-- Navigation Bar -->

<header>
    <div class="logo">movie<span>pass</span></div>

    <nav>
        <a href="#">Movies</a>
        <a href="#">Events</a>
        <a href="#">Plays</a>
        <a href="#">Sports</a>
        <a href="#">Activities</a>
    </nav>

    <button class="header-login"
            onclick="document.getElementById('email').focus()">
        Login
    </button>
</header>

<!-- Main Content -->

<main class="container">

    <!-- Cinema Section -->

    <section class="cinema">

        <div class="logo">movie<span>pass</span></div>

        <h1>
            Movies. Events.<br>
            <span>Unforgettable</span> Moments.
        </h1>

        <p>
            Book your next experience with just a click.
            Discover movies, live events, plays and more.
        </p>

        <div class="features">

            <div class="feature">
                <strong>🎟 Tickets</strong>
                Easy booking
            </div>

            <div class="feature">
                <strong>🛡 Security</strong>
                Safe experience
            </div>

            <div class="feature">
                <strong>⚡ Instant</strong>
                Quick confirmation
            </div>

        </div>

    </section>

    <!-- Login Form -->

    <section class="login-panel">

        <div class="login-box">

            <h2>Log In</h2>

            <p class="subtitle">
                Welcome back! Sign in to discover your next experience.
            </p>

            <form id="loginForm">

                <div class="form-group">
                    <label for="email">
                        Mobile Number or Email
                    </label>

                    <input
                        type="text"
                        id="email"
                        placeholder="Enter your mobile number or email"
                        autocomplete="username"
                        required
                    >
                </div>

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                        <button
                            type="button"
                            class="toggle-password"
                            id="togglePassword"
                        >
                            Show
                        </button>

                    </div>

                </div>

                <a href="#" class="forgot" id="forgotPassword">
                    Forgot Password?
                </a>

                <button type="submit" class="login-button">
                    Log In
                </button>

            </form>

            <p id="message" role="status" aria-live="polite"></p>

            <div class="divider">or</div>

            <button type="button"
                    class="google-button"
                    id="googleLogin">
                🌐 Continue with Google
            </button>

            <p class="signup">
                Don't have an account?
                <a href="#" id="signupLink">Sign Up</a>
            </p>

        </div>

    </section>

</main>

<!-- JavaScript -->

<script>
    const loginForm = document.getElementById("loginForm");
    const passwordInput = document.getElementById("password");
    const message = document.getElementById("message");

    // Show or hide password

    document.getElementById("togglePassword")
        .addEventListener("click", function () {

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                this.textContent = "Hide";
            } else {
                passwordInput.type = "password";
                this.textContent = "Show";
            }
        });

    // Demonstration login only

    loginForm.addEventListener("submit", function (event) {
        event.preventDefault();

        const email = document.getElementById("email").value.trim();
        const password = passwordInput.value;

        if (!email || !password) {
            message.style.color = "#d9163b";
            message.textContent = "Please fill in all fields.";
            return;
        }

        message.style.color = "#b45309";
        message.textContent =
            "Demo login only. Connect a secure backend to authenticate users.";
    });

    // Demonstration buttons

    document.getElementById("forgotPassword")
        .addEventListener("click", function (event) {
            event.preventDefault();

            message.style.color = "#555";
            message.textContent =
                "Password recovery needs to be connected to a backend.";
        });

    document.getElementById("signupLink")
        .addEventListener("click", function (event) {
            event.preventDefault();

            message.style.color = "#555";
            message.textContent =
                "Create a separate signup page to register new users.";
        });

    document.getElementById("googleLogin")
        .addEventListener("click", function () {

            message.style.color = "#555";
            message.textContent =
                "Google sign-in requires Google Identity Services and backend verification.";
        });
</script>
